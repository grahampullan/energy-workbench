{
  "schemaVersion": "0.1.0",
  "id": "model.material-inventory-synthetic",
  "name": "Synthetic heated material inventory",
  "components": [
    {
      "id": "material-source",
      "type": "material.source",
      "definitionVersion": "0.1.0",
      "name": "Material source",
      "parameters": {
        "massFlowSeriesId": "material-inflow",
        "specificEnthalpyKjPerKg": 100
      },
      "initialState": {}
    },
    {
      "id": "grid",
      "type": "electrical.grid",
      "definitionVersion": "0.2.0",
      "name": "Grid",
      "parameters": {
        "maximumImportPowerkW": 20,
        "maximumExportPowerkW": 0
      },
      "initialState": {},
      "policy": {
        "type": "electrical.balance",
        "settings": {}
      }
    },
    {
      "id": "heater",
      "type": "thermal.electric-heater",
      "definitionVersion": "0.3.0",
      "name": "Electric heater",
      "parameters": {
        "maximumElectricalInputPowerkW": 10,
        "efficiency": 1,
        "supplyTemperatureC": 150
      },
      "initialState": {},
      "policy": {
        "type": "electrical.follow-schedule",
        "settings": {
          "direction": -1
        }
      }
    },
    {
      "id": "inventory",
      "type": "thermal.store",
      "definitionVersion": "0.3.0",
      "name": "Heated inventory",
      "parameters": {
        "maximumMassKg": 120,
        "specificHeatCapacityKjPerKgK": 1,
        "enthalpyReferenceTemperatureC": 0,
        "maximumTemperatureC": 200,
        "minimumUsefulTemperatureC": 0,
        "maximumHeatInputkW": 10,
        "maximumHeatOutputkW": 0
      },
      "initialState": {
        "massKg": 0,
        "containedEnthalpykWh": 0
      },
      "policy": {
        "type": "material.follow-schedule",
        "settings": {}
      }
    },
    {
      "id": "material-sink",
      "type": "material.sink",
      "definitionVersion": "0.1.0",
      "name": "Material sink",
      "parameters": {},
      "initialState": {}
    }
  ],
  "connections": [
    {
      "id": "source-to-inventory",
      "name": "Material source to inventory",
      "from": {
        "componentId": "material-source",
        "portId": "material-out"
      },
      "to": {
        "componentId": "inventory",
        "portId": "material-in"
      }
    },
    {
      "id": "grid-to-heater",
      "name": "Grid to heater",
      "from": {
        "componentId": "grid",
        "portId": "electricity"
      },
      "to": {
        "componentId": "heater",
        "portId": "electricity-in"
      }
    },
    {
      "id": "heater-to-inventory",
      "name": "Heater to inventory",
      "from": {
        "componentId": "heater",
        "portId": "heat-out"
      },
      "to": {
        "componentId": "inventory",
        "portId": "heat-in"
      }
    },
    {
      "id": "inventory-to-sink",
      "name": "Inventory to material sink",
      "from": {
        "componentId": "inventory",
        "portId": "material-out"
      },
      "to": {
        "componentId": "material-sink",
        "portId": "material-in"
      }
    }
  ],
  "informationSources": [
    {
      "id": "heating-schedule",
      "name": "Heater power schedule",
      "seriesId": "heater-input-power",
      "quantity": "active-power",
      "unit": "kW"
    },
    {
      "id": "discharge-schedule",
      "name": "Discharge schedule",
      "seriesId": "material-outflow",
      "quantity": "mass-rate",
      "unit": "kg/s"
    }
  ],
  "informationConnections": [
    {
      "id": "info-heating-schedule-value-to-heater-policy-power",
      "name": "Heater power",
      "from": {
        "sourceId": "heating-schedule",
        "portId": "value"
      },
      "to": {
        "componentId": "heater",
        "portId": "policy.power"
      }
    },
    {
      "id": "info-discharge-schedule-value-to-inventory-policy-request",
      "name": "Discharge schedule",
      "from": {
        "sourceId": "discharge-schedule",
        "portId": "value"
      },
      "to": {
        "componentId": "inventory",
        "portId": "policy.request"
      }
    }
  ]
}
