{
  "schemaVersion": "0.1.0",
  "id": "model.coupled-thermal",
  "name": "Coupled electrical and hot-water system",
  "components": [
    {
      "id": "grid",
      "type": "electrical.grid",
      "definitionVersion": "0.2.0",
      "name": "Grid",
      "parameters": {
        "maximumImportPowerkW": 120,
        "maximumExportPowerkW": 0
      },
      "initialState": {},
      "policy": {
        "type": "electrical.balance",
        "settings": {}
      }
    },
    {
      "id": "heater",
      "type": "thermal.electric-heater",
      "definitionVersion": "0.3.0",
      "name": "Electric heater",
      "parameters": {
        "maximumElectricalInputPowerkW": 100,
        "efficiency": 0.9,
        "supplyTemperatureC": 90
      },
      "initialState": {},
      "policy": {
        "type": "thermal.follow-demand",
        "settings": {}
      }
    },
    {
      "id": "store",
      "type": "thermal.store",
      "definitionVersion": "0.3.0",
      "name": "Hot-water store",
      "parameters": {
        "maximumMassKg": 10000,
        "specificHeatCapacityKjPerKgK": 3.6,
        "enthalpyReferenceTemperatureC": 0,
        "maximumTemperatureC": 90,
        "minimumUsefulTemperatureC": 70,
        "maximumHeatInputkW": 80,
        "maximumHeatOutputkW": 120
      },
      "initialState": {
        "massKg": 10000,
        "containedEnthalpykWh": 800
      }
    },
    {
      "id": "store-loss",
      "type": "thermal.heat-transfer",
      "definitionVersion": "0.2.0",
      "name": "Heat loss",
      "parameters": {
        "conductancekWPerK": 0.05
      },
      "initialState": {}
    },
    {
      "id": "heat-demand",
      "type": "thermal.heat-demand",
      "definitionVersion": "0.2.0",
      "name": "Heat demand",
      "parameters": {
        "demandSeriesId": "thermal-demand",
        "profileMultiplier": 1,
        "minimumDeliveryTemperatureC": 70
      },
      "initialState": {}
    },
    {
      "id": "ambient",
      "type": "thermal.constant-temperature",
      "definitionVersion": "0.1.0",
      "name": "Ambient",
      "parameters": {
        "temperatureSeriesId": "ambient-temperature"
      },
      "initialState": {}
    }
  ],
  "connections": [
    {
      "id": "grid-to-heater",
      "name": "Grid to electric heater",
      "from": {
        "componentId": "grid",
        "portId": "electricity"
      },
      "to": {
        "componentId": "heater",
        "portId": "electricity-in"
      }
    },
    {
      "id": "heater-to-store",
      "name": "Heater to hot-water store",
      "from": {
        "componentId": "heater",
        "portId": "heat-out"
      },
      "to": {
        "componentId": "store",
        "portId": "heat-in"
      }
    },
    {
      "id": "store-to-demand",
      "name": "Hot-water store to heat demand",
      "from": {
        "componentId": "store",
        "portId": "heat-out"
      },
      "to": {
        "componentId": "heat-demand",
        "portId": "heat-in"
      }
    },
    {
      "id": "store-to-loss",
      "name": "Hot-water store to heat loss",
      "from": {
        "componentId": "store",
        "portId": "passive-heat-out"
      },
      "to": {
        "componentId": "store-loss",
        "portId": "source"
      }
    },
    {
      "id": "store-to-ambient",
      "name": "Hot-water store heat loss to ambient",
      "from": {
        "componentId": "store-loss",
        "portId": "sink"
      },
      "to": {
        "componentId": "ambient",
        "portId": "heat-in"
      }
    }
  ],
  "informationSources": [],
  "informationConnections": [
    {
      "id": "info-heat-demand-requested-heat-to-heater-policy-demand",
      "name": "Requested heat",
      "from": {
        "componentId": "heat-demand",
        "portId": "requested-heat"
      },
      "to": {
        "componentId": "heater",
        "portId": "policy.demand"
      }
    },
    {
      "id": "info-heater-efficiency-to-heater-policy-efficiency",
      "name": "Heater efficiency",
      "from": {
        "componentId": "heater",
        "portId": "efficiency"
      },
      "to": {
        "componentId": "heater",
        "portId": "policy.efficiency"
      }
    }
  ]
}
