{
  "schemaVersion": "0.1.0",
  "id": "model.batch-heating-synthetic",
  "name": "Synthetic batch-heating process",
  "components": [
    {
      "id": "grid",
      "type": "electrical.grid",
      "definitionVersion": "0.2.0",
      "name": "Grid",
      "parameters": {
        "maximumImportPowerkW": 60,
        "maximumExportPowerkW": 0
      },
      "initialState": {},
      "policy": {
        "type": "electrical.balance",
        "settings": {}
      }
    },
    {
      "id": "heater",
      "type": "thermal.electric-heater",
      "definitionVersion": "0.2.0",
      "name": "Electric heater",
      "parameters": {
        "maximumElectricalInputPowerkW": 50,
        "efficiency": 0.9,
        "supplyTemperatureC": 150
      },
      "initialState": {},
      "policy": {
        "type": "electrical.follow-schedule",
        "settings": {
          "direction": -1
        }
      }
    },
    {
      "id": "batch",
      "type": "thermal.store",
      "definitionVersion": "0.2.0",
      "name": "Batch",
      "parameters": {
        "maximumMassKg": 1000,
        "specificHeatCapacityKjPerKgK": 3.6,
        "enthalpyReferenceTemperatureC": 0,
        "maximumTemperatureC": 145,
        "minimumUsefulTemperatureC": 120,
        "maximumHeatInputkW": 50,
        "maximumHeatOutputkW": 0
      },
      "initialState": {
        "massKg": 1000,
        "containedEnthalpykWh": 20
      }
    },
    {
      "id": "batch-loss",
      "type": "thermal.heat-transfer",
      "definitionVersion": "0.1.0",
      "name": "Heat loss",
      "parameters": {
        "conductancekWPerK": 0.1
      },
      "initialState": {}
    },
    {
      "id": "ambient",
      "type": "thermal.constant-temperature",
      "definitionVersion": "0.1.0",
      "name": "Ambient",
      "parameters": {
        "temperatureSeriesId": "ambient-temperature"
      },
      "initialState": {}
    }
  ],
  "connections": [
    {
      "id": "grid-to-heater",
      "name": "Grid to electric heater",
      "from": {
        "componentId": "grid",
        "portId": "electricity"
      },
      "to": {
        "componentId": "heater",
        "portId": "electricity-in"
      }
    },
    {
      "id": "heater-to-batch",
      "name": "Heater to batch",
      "from": {
        "componentId": "heater",
        "portId": "heat-out"
      },
      "to": {
        "componentId": "batch",
        "portId": "heat-in"
      }
    },
    {
      "id": "batch-to-loss",
      "name": "Batch to heat loss",
      "from": {
        "componentId": "batch",
        "portId": "passive-heat-out"
      },
      "to": {
        "componentId": "batch-loss",
        "portId": "source"
      }
    },
    {
      "id": "batch-to-ambient",
      "name": "Batch heat loss to ambient",
      "from": {
        "componentId": "batch-loss",
        "portId": "sink"
      },
      "to": {
        "componentId": "ambient",
        "portId": "heat-in"
      }
    }
  ],
  "informationSources": [
    {
      "id": "heating-schedule",
      "name": "Heater power schedule",
      "seriesId": "heater-input-power",
      "quantity": "active-power",
      "unit": "kW"
    }
  ],
  "informationConnections": [
    {
      "id": "info-heating-schedule-value-to-heater-policy-power",
      "name": "Heater power",
      "from": {
        "sourceId": "heating-schedule",
        "portId": "value"
      },
      "to": {
        "componentId": "heater",
        "portId": "policy.power"
      }
    }
  ]
}
