{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:energy-workbench:schema:scenario:0.1.0",
  "title": "Energy Workbench scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "time", "series"],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "id": {
      "$ref": "urn:energy-workbench:schema:common:0.1.0#/$defs/stableId"
    },
    "name": {
      "$ref": "urn:energy-workbench:schema:common:0.1.0#/$defs/nonEmptyString"
    },
    "time": {
      "$ref": "#/$defs/timeAxis"
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/series"
      }
    }
  },
  "$defs": {
    "timeAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeStepSeconds", "stepCount"],
      "properties": {
        "startTime": {
          "type": "string",
          "minLength": 1
        },
        "timeStepSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stepCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "unit", "data"],
      "properties": {
        "id": {
          "$ref": "urn:energy-workbench:schema:common:0.1.0#/$defs/stableId"
        },
        "name": {
          "$ref": "urn:energy-workbench:schema:common:0.1.0#/$defs/nonEmptyString"
        },
        "unit": {
          "$ref": "urn:energy-workbench:schema:common:0.1.0#/$defs/nonEmptyString"
        },
        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/inlineSeriesData"
            },
            {
              "$ref": "#/$defs/csvSeriesData"
            }
          ]
        }
      }
    },
    "inlineSeriesData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": {
          "const": "inline"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "csvSeriesData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "valueColumn"],
      "properties": {
        "kind": {
          "const": "csv-column"
        },
        "path": {
          "$ref": "urn:energy-workbench:schema:common:0.1.0#/$defs/relativePath"
        },
        "valueColumn": {
          "$ref": "urn:energy-workbench:schema:common:0.1.0#/$defs/nonEmptyString"
        },
        "timeColumn": {
          "$ref": "urn:energy-workbench:schema:common:0.1.0#/$defs/nonEmptyString"
        }
      }
    }
  }
}
